name:               tobisite
version:            0.1.0.0
build-type:         Simple
cabal-version:      >= 1.10

executable site
  main-is:          site.hs
  build-depends:    base == 4.*
                  , clay
                  , text
                  , hakyll == 4.16.*
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N
  default-language: Haskell2010
  hs-source-dirs: 
    css,
    ./
  other-modules: MyCss
